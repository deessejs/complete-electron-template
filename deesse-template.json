{
  "$schema": "https://raw.githubusercontent.com/deessejs/deessejs/main/templates/schema/template-v2.json",
  "name": "complete-electron-template",
  "slug": "electron-starter",
  "title": "Electron Starter",
  "description": "A desktop application on Electron, React 19, TanStack Start, Drizzle and oRPC, sharing the same contracts as the web stack.",
  "version": "1.0.0",
  "type": "template:starter",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "source": {
    "repo": "deessejs/complete-electron-template",
    "ref": "main"
  },
  "requires": {
    "runtime": "node",
    "node": ">=22.13.0",
    "packageManager": "pnpm@9.15.0"
  },
  "product": {
    "layer": "open-community",
    "category": "desktop",
    "labels": ["electron", "react", "tanstack-start", "orpc"],
    "image": "/ship-your-electron-app.png"
  },
  "includes": ["**"],
  "excludes": [
    ".changeset/*.md",
    ".claude/settings.local.json",
    ".claude/agent-memory/**",
    ".claude/plans/**",
    ".claude/worktrees/**",
    ".claude/pr-body-*.md",
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "CHANGELOG.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    "**/.env",
    "**/.env.*"
  ],
  "fileTypes": {
    "scripts/setup.ts": "source",
    "README.md": "doc",
    "LICENSE": "doc",
    "CLAUDE.md": "doc"
  }
}
