{
  "$schema": "https://app.deessejs.com/schema/template/v1.json",
  "formatVersion": 1,
  "name": "complete-electron-template",
  "title": "Electron Starter",
  "description": "A production-ready Electron application template with React 19, TanStack Start, Drizzle ORM, and oRPC.",
  "version": "1.0.0",
  "type": "template:desktop",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "category": "desktop",
  "labels": [
    "electron",
    "react",
    "tanstack-start",
    "orpc"
  ],
  "source": {
    "repo": "deessejs/complete-electron-template"
  },
  "includes": [
    "**/*"
  ],
  "excludes": [
    "deesse-template.json",
    ".changeset/**",
    ".claude/**",
    ".codex/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "docs/**",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    ".env",
    "**/.env",
    ".env.local",
    "**/.env.local",
    ".env.*.local",
    "**/.env.*.local",
    ".env.development",
    "**/.env.development",
    ".env.production",
    "**/.env.production",
    ".env.test",
    "**/.env.test"
  ]
}
